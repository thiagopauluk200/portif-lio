# Copie para .env.local e preencha. NUNCA versione o .env.local.

# Chave secreta do painel admin (mínimo 32 caracteres).
# Gere uma com:  npm run gen:key
ADMIN_SECRET_KEY=

# (Opcional) Webhook compatível com Discord/Slack para ser notificado
# a cada nova mensagem do formulário de contato.
CONTACT_WEBHOOK_URL=
